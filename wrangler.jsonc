{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "browsershot-landing",
  "compatibility_date": "2026-02-24",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "browsershot.dev", "custom_domain": true },
    { "pattern": "mta-sts.browsershot.dev", "custom_domain": true }
  ]
}
